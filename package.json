{
  "name": "compose-knowledge",
  "version": "0.2.0",
  "private": true,
  "description": "Version-aware, source-grounded Compose reference retrieval for Codex",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "compose-knowledge": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=3",
    "test:watch": "vitest",
    "corpus:build": "node dist/cli.js build --input tests/fixtures/knowledge-input.json --out .cache/corpus --json",
    "evaluate": "node scripts/evaluate.mjs",
    "bundle": "node scripts/bundle.mjs"
  },
  "dependencies": {
    "parse5": "8.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
